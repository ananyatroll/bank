# TON Blockchain (Testnet)
TON_TESTNET_RPC_URL=https://testnet.toncenter.com/api/v2
TON_TESTNET_EXPLORER=https://testnet.tonviewer.com

# Ethereum (Sepolia Testnet)
ETH_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ETH_SEPOLIA_CHAIN_ID=11155111

# App Configuration
APP_NAME=TeleBank UI
APP_VERSION=1.0.0
SUPPORTED_BANKS=CBE,Dashen,Awash,COOP
DEFAULT_CURRENCY=ETB

# Security
ENCRYPTION_KEY_SALT=your-random-salt-here
BIOMETRIC_TIMEOUT=30

# Feature Flags
ENABLE_CRYPTO_WALLET=true
ENABLE_SMS_SYNC=true
ENABLE_USSD_WRAPPER=true
ENABLE_DARK_MODE=true
